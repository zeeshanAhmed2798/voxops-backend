# ============================================================
# VoxOps Backend — .gitignore
# ============================================================

# Environment variables — NEVER commit this
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environment
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
.eggs/

# pytest cache
.pytest_cache/
.cache/

# Coverage reports
htmlcov/
.coverage
coverage.xml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Alembic auto-generated (keep versions tracked, not cache)
alembic/__pycache__/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

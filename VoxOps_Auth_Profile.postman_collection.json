{
  "info": {
    "_postman_id": "voxops-full-api-v2",
    "name": "VoxOps API — Full Collection v2",
    "description": "Complete API collection for VoxOps Backend.\n\nIncludes: Auth, User Profile, Knowledge Base.\n\n**How to use:**\n1. Run the 'Login' request\n2. The access_token is auto-saved to the {{access_token}} variable\n3. All protected requests use {{access_token}} automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Change to your production URL when deploying"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "Auto-populated after login"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "Auto-populated after login — use for /auth/refresh"
    },
    {
      "key": "invite_token",
      "value": "",
      "type": "string",
      "description": "Populated after calling invite-member"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string",
      "description": "Populated after calling forgot-password"
    },
    {
      "key": "kb_doc_id",
      "value": "",
      "type": "string",
      "description": "Populated after creating a KB document"
    },
    {
      "key": "verify_token",
      "value": "",
      "type": "string",
      "description": "Manually paste this from your email/console to test verify-email"
    }
  ],
  "item": [
    {
      "name": "🏥 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Verify the API is running"
          }
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/",
            "description": "Root endpoint"
          }
        }
      ]
    },
    {
      "name": "🔐 Auth — Register",
      "item": [
        {
          "name": "Register Org + Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Tokens saved. access_token:', body.access_token.substring(0,20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_name\": \"My Company\",\n  \"full_name\": \"Jane Doe\",\n  \"email\": \"jane@mycompany.com\",\n  \"password\": \"dummy_password\"\n}"
            },
            "description": "Creates a new Organization + first Admin user. Returns access + refresh token. Run this once per company."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/verify-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verify_token}}\"\n}"
            },
            "description": "Verifies the email address using the token."
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/resend-verification-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@mycompany.com\"\n}"
            },
            "description": "Resends the verification email."
          }
        },
        {
          "name": "Invite Member (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('invite_token', body.invite_token);",
                  "  console.log('Invite token saved:', body.invite_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/auth/invite-member",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@mycompany.com\",\n  \"full_name\": \"Bob Smith\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "description": "Admin only. Generates an invite token for the given email. Token is saved to {{invite_token}}."
          }
        },
        {
          "name": "Register Member (via Invite)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  console.log('Member registered. access_token:', body.access_token.substring(0,20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/register-member",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_token\": \"{{invite_token}}\",\n  \"full_name\": \"Bob Smith\",\n  \"password\": \"dummy_password\"\n}"
            },
            "description": "Uses the invite token from 'Invite Member'. No admin token required."
          }
        }
      ]
    },
    {
      "name": "🔑 Auth — Login & Session",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Logged in. Tokens saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"dummy_password\"\n}"
            },
            "description": "Login with email + password. Saves access_token and refresh_token to collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Tokens rotated and saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "description": "Get a new access_token + rotated refresh_token. Run this when the access token expires."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "description": "Deletes the refresh token from the database. Future refresh attempts with this token will fail."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "Returns the current user's profile based on the JWT."
          }
        }
      ]
    },
    {
      "name": "🔒 Auth — Password",
      "item": [
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"dummy_password\",\n  \"new_password\": \"new_dummy_password\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.reset_token) {",
                  "    pm.collectionVariables.set('reset_token', body.reset_token);",
                  "    console.log('Reset token saved:', body.reset_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\"\n}"
            },
            "description": "In dev mode, the reset_token is returned in the response AND saved to {{reset_token}}."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"new_dummy_password\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "👤 User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/users/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe Updated\",\n  \"job_title\": \"CTO\",\n  \"phone\": \"+92-300-1234567\",\n  \"timezone\": \"Asia/Karachi\"\n}"
            },
            "description": "Update own profile. Only send fields you want to change."
          }
        }
      ]
    },
    {
      "name": "📚 Knowledge Base",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/knowledge-base?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "knowledge-base"],
              "query": [
                {"key": "skip", "value": "0"},
                {"key": "limit", "value": "20"},
                {"key": "category", "value": "", "disabled": true},
                {"key": "search", "value": "", "disabled": true}
              ]
            },
            "description": "Lists all KB documents for your org. Admins see drafts too. Use category/search params to filter."
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/knowledge-base/{{kb_doc_id}}",
            "description": "Get full content of a single document."
          }
        },
        {
          "name": "Create Document (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('kb_doc_id', body.id);",
                  "  console.log('KB doc id saved:', body.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/knowledge-base",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Employee Handbook 2026\",\n  \"content\": \"# Employee Handbook\\n\\nWelcome to our team! This document covers everything you need to know.\",\n  \"category\": \"HR Policies\",\n  \"is_published\": true\n}"
            },
            "description": "Admin only. Returns 403 for non-admin users. Saves doc ID to {{kb_doc_id}}."
          }
        },
        {
          "name": "Update Document (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/knowledge-base/{{kb_doc_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Employee Handbook 2026 (Updated)\",\n  \"is_published\": true\n}"
            },
            "description": "Admin only. Send only the fields you want to change."
          }
        },
        {
          "name": "Delete Document (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/v1/knowledge-base/{{kb_doc_id}}",
            "description": "Admin only. Permanently deletes the document. Returns 204 No Content."
          }
        },
        {
          "name": "❌ Member tries to Create (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/v1/knowledge-base",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"I should not be able to create this\",\n  \"content\": \"Members cannot create KB docs.\"\n}"
            },
            "description": "Login as a member user first, then run this. Should return 403 Forbidden."
          }
        }
      ]
    }
  ]
}

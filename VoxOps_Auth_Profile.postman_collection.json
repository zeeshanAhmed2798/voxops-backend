{
  "info": {
    "name": "VoxOps Backend — Auth & Profile",
    "description": "Complete Postman collection for all VoxOps authentication and user profile endpoints.\n\n**How to use:**\n1. Import this file into Postman (File → Import)\n2. Run 'Login' first — it auto-saves your token\n3. All protected requests use the saved token automatically\n\n**Dev credentials:**\n- Email: jane@example.com\n- Password: ChangeMe123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Base URL of the running FastAPI server"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token — auto-filled after running the Login request"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET / — Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Simple health check. No auth required.\n\nExpected response:\n```json\n{\n  \"message\": \"VoxOps Backend is running\",\n  \"version\": \"1.0.0\",\n  \"status\": \"ok\"\n}\n```"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /auth/login — Login (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.access_token);",
                  "    console.log('Token saved! Run protected endpoints now.');",
                  "} else {",
                  "    console.log('Login failed:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jane@example.com\",\n    \"password\": \"ChangeMe123!\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login with email + password. Auto-saves the JWT token to {{token}} collection variable.\n\nExpected: 200 + access_token\nWrong password: 401\nInvalid email format: 422"
          },
          "response": []
        },
        {
          "name": "POST /auth/login — FAIL Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jane@example.com\",\n    \"password\": \"WrongPassword!\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Expected: 401 Unauthorized\nDetail: Incorrect email or password."
          },
          "response": []
        },
        {
          "name": "POST /auth/login — FAIL Invalid Email Format (422)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"notanemail\",\n    \"password\": \"ChangeMe123!\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Expected: 422 Unprocessable Entity\nPydantic EmailStr rejects invalid email format."
          },
          "response": []
        },
        {
          "name": "GET /auth/me — Get Current User",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns authenticated user profile. password_hash is NEVER returned.\n\nRun Login first to fill {{token}}."
          },
          "response": []
        },
        {
          "name": "GET /auth/me — FAIL No Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Expected: 401 Unauthorized — no token provided."
          },
          "response": []
        },
        {
          "name": "GET /auth/me — FAIL Invalid Token (401)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer this.is.not.a.valid.jwt"}],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Expected: 401 Unauthorized — tampered JWT rejected."
          },
          "response": []
        },
        {
          "name": "POST /auth/logout — Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization","value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Logout. Server instructs client to discard token.\nJWT is stateless so server cannot invalidate it — client must delete the token."
          },
          "response": []
        },
        {
          "name": "POST /auth/change-password — Change Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"},
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"current_password\": \"ChangeMe123!\",\n    \"new_password\": \"NewSecurePass456!\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "description": "Change password.\n- Must provide correct current password\n- New password min 8 characters\n- Cannot reuse same password\n\nAfter running this, login again with the new password."
          },
          "response": []
        },
        {
          "name": "POST /auth/change-password — FAIL Wrong Current (400)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"},
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"current_password\": \"WrongCurrentPassword!\",\n    \"new_password\": \"NewSecurePass456!\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "description": "Expected: 400 Bad Request\nDetail: Current password is incorrect."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "GET /users/me — Get My Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Get full user profile. password_hash never returned."
          },
          "response": []
        },
        {
          "name": "PATCH /users/me — Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"},
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Updated\",\n    \"job_title\": \"Lead Engineer\",\n    \"phone\": \"+92-300-1234567\",\n    \"timezone\": \"Asia/Karachi\",\n    \"profile_picture\": \"https://cdn.example.com/avatars/jane.jpg\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Update profile fields (PATCH = only send what you want to change).\n\nEditable: name, job_title, phone, timezone, profile_picture\nProtected (ignored): id, organization_id, role, status, email, password_hash"
          },
          "response": []
        },
        {
          "name": "PATCH /users/me — SECURITY: Try to Change Role (should be ignored)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"},
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"role\": \"SUPER_ADMIN\",\n    \"name\": \"Jane Doe\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Security test: sending role=SUPER_ADMIN.\n\nExpected: role field is silently ignored.\nResponse will show original role (ORG_ADMIN), not SUPER_ADMIN.\nUsers cannot escalate their own privileges."
          },
          "response": []
        },
        {
          "name": "PATCH /users/me — SECURITY: Try to Change Org ID (should be ignored)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"},
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"organization_id\": \"99999999-9999-9999-9999-999999999999\",\n    \"name\": \"Jane Doe\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Security test: trying to change organization_id.\n\nExpected: organization_id is silently ignored.\nOriginal org ID remains unchanged.\nCritical for multi-tenant isolation."
          },
          "response": []
        },
        {
          "name": "PATCH /users/me — FAIL No Auth (401)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type","value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Hacker\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Expected: 401 Unauthorized — cannot update profile without being logged in."
          },
          "response": []
        }
      ]
    }
  ]
}
